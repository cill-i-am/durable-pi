{
  "name": "durable-pi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --stage dev --profile default",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "deploy": "alchemy deploy --stage production --profile durable-pi",
    "test": "vitest run",
    "verify": "pnpm generate-routes && pnpm typecheck && pnpm test && pnpm build",
    "model:login": "tsx scripts/model-login.ts"
  },
  "dependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.81",
    "@base-ui/react": "^1.8.0",
