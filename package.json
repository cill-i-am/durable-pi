{
  "name": "durable-pi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --stage dev --profile default",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:workers": "node scripts/build-workers.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "deploy": "alchemy deploy --stage production --profile durable-pi",
    "test": "vitest run",
    "verify": "pnpm verify:static && pnpm verify:unit-and-build && pnpm verify:native-runtime",
    "verify:static": "node --import tsx scripts/check-secrets.ts && pnpm generate-routes && pnpm db:check:agent && pnpm typecheck && pnpm lint && pnpm check",
    "verify:unit-and-build": "pnpm generate-routes && pnpm test && pnpm build && pnpm build:workers",
    "verify:native-runtime": "pnpm generate-routes && pnpm test:communication-runtime && pnpm test:drizzle-runtime",
    "model:login": "tsx scripts/model-login.ts",
    "test:communication-runtime": "node scripts/test-communication-runtime.mjs",
    "db:generate:agent": "drizzle-kit generate --config drizzle.agent.config.ts && node scripts/generate-agent-migration-manifest.mjs",
    "db:check:agent": "node scripts/generate-agent-migration-manifest.mjs --check",
    "test:drizzle-runtime": "node scripts/test-drizzle-runtime.mjs"
  },
  "dependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.81",
    "@base-ui/react": "^1.9.0",
    "@cloudflare/puppeteer": "1.4.0",
    "@cloudflare/sandbox": "0.12.10",
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@effect/platform-bun": "4.0.1",
    "@effect/platform-node": "4.0.1",
    "@effect/sql-sqlite-do": "4.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/ai": "0.68.0",
    "@tanstack/ai-client": "0.39.2",
    "@tanstack/ai-react": "0.30.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "agents": "0.27.0",
    "alchemy": "2.0.0-beta.81",
    "better-auth": "1.7.7",
    "border-beam": "1.4.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.1",
    "hono": "4.13.13",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "next-themes": "0.4.6",
    "parse5": "8.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.21.3",
    "shiki": "^4.5.0",
    "tailwindcss": "^4",
    "thinking-orbs": "0.3.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@effect/sql-sqlite-node": "4.0.1",
    "@effect/vitest": "4.0.1",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.39",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "eslint": "^10",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "packageManager": "pnpm@12.4.2"
}
