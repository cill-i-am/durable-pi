    "@effect/sql-sqlite-do": "4.0.5",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@json-render/core": "0.21.1",
    "@json-render/react": "0.21.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "0.69.0",
    "@tanstack/ai-client": "0.39.3",
    "@tanstack/ai-react": "0.30.4",
    "@tanstack/query-core": "5.104.1",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-table": "^8.21.3",
    "@tiesen/effect-tanstack-query": "0.0.26",
    "@workspace/ui": "workspace:*",
    "@xstate/effect": "1.0.0-alpha.8",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "agents": "0.28.1",
    "alchemy": "2.0.0-beta.83",
    "better-auth": "1.7.10",
    "chat": "4.42.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.5",
    "hono": "4.13.13",
    "input-otp": "^1.5.0",
    "jose": "6.2.12",
    "lucide-react": "^1.58.0",
    "maplibre-gl": "^6.14.0",
    "next-themes": "0.4.6",
    "parse5": "8.0.1",
    "postal-mime": "4.0.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "6.11.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.22.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.0",
    "xstate": "6.0.0-alpha.68",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chat-adapter/state-memory": "4.42.0",
    "@cloudflare/sandbox-v0": "npm:@cloudflare/sandbox@0.12.10",
    "@cloudflare/workers-types": "5.20261016.1",
    "@effect/sql-sqlite-node": "4.0.5",
    "@effect/tsgo": "0.53.3",
    "@effect/vitest": "4.0.5",
    "@playwright/test": "1.64.1",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@yielded/effect-tsrs": "0.2.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-effect": "0.29.0",
    "oxlint-plugin-react-doctor": "0.9.16",
    "oxlint-tsgolint": "7.0.2004",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "8.0.1",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "packageManager": "pnpm@12.14.0"
