{
  "name": "durable-pi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --stage dev --profile default",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:workers": "node scripts/build-workers.mjs",
    "preview": "vite preview",
    "lint": "oxlint --config oxlint.config.ts --deny-warnings",
    "format": "oxfmt --write .",
    "check": "oxfmt --check .",
    "typecheck": "tsrs --noEmit",
    "deploy": "alchemy deploy --stage production --profile durable-pi",
    "test": "vitest run",
    "verify": "pnpm verify:static && pnpm verify:unit-and-build && pnpm verify:native-runtime && pnpm verify:browser && pnpm verify:container",
    "verify:static": "node --import tsx scripts/check-secrets.ts && pnpm generate-routes && pnpm db:check:agent && pnpm typecheck && pnpm lint:effect && pnpm test:tooling && pnpm lint && pnpm check",
    "verify:unit-and-build": "pnpm generate-routes && pnpm test && pnpm build && node scripts/check-website-routes.mjs && pnpm build:workers",
    "verify:native-runtime": "pnpm generate-routes && pnpm test:communication-runtime && pnpm test:communication-control-runtime && pnpm test:coordination-runtime && pnpm test:conversation-runtime && pnpm test:workspace-runtime && pnpm test:routines-runtime && pnpm test:apps-runtime && pnpm test:drizzle-runtime && pnpm test:whatsapp-runtime && pnpm test:background-stop-runtime && pnpm test:memory-runtime && pnpm test:memory-summary-runtime && pnpm test:memory-backup-runtime && pnpm test:upstream-runtime && pnpm test:xstate-runtime",
    "test:xstate-runtime": "node scripts/test-xstate-runtime.mjs",
    "test:background-stop-runtime": "node scripts/test-background-stop-runtime.mjs",
    "test:whatsapp-runtime": "node scripts/test-whatsapp-runtime.mjs",
    "model:login": "tsx scripts/model-login.ts",
    "model:reauthorize": "tsx scripts/model-reauthorize.ts",
    "test:communication-runtime": "node scripts/test-communication-runtime.mjs",
    "test:communication-control-runtime": "node scripts/test-communication-control-runtime.mjs",
    "test:coordination-runtime": "node scripts/test-coordination-runtime.mjs",
    "db:generate:agent": "drizzle-kit generate --config drizzle.agent.config.ts && node scripts/generate-agent-migration-manifest.mjs",
    "db:check:agent": "node scripts/generate-agent-migration-manifest.mjs --check",
    "test:drizzle-runtime": "node scripts/test-drizzle-runtime.mjs",
    "test:browser": "playwright test",
    "eval:rich-answers:live": "tsx evals/rich-answers/live.ts",
    "eval:rich-answers:score": "tsx evals/rich-answers/score.ts",
    "eval:family-invitations:score": "node --import tsx evals/family-invitations/score.ts",
    "verify:browser": "pnpm build && pnpm test:browser && pnpm test:browser-components && node --import tsx scripts/check-passkeys.mjs && pnpm test:client-upgrade",
    "verify:container": "docker build --platform linux/amd64 --tag durable-pi-ci:terminal containers/terminal && docker build --platform linux/amd64 --tag durable-pi-ci:terminal-native containers/terminal-native",
    "dev:sandbox": "alchemy dev stacks/sandbox-rehearsal.ts --stage sandbox-rehearsal --profile default",
    "test:sandbox": "node scripts/check-native-sandbox.mjs",
    "lint:fix": "oxlint --config oxlint.config.ts --fix",
    "prepare": "effect-tsgo patch --oxlint",
    "complexity:report": "cccc src scripts tests stacks",
    "eval:coordination": "tsx scripts/eval-coordination.ts",
    "test:memory-runtime": "node scripts/test-memory-runtime.mjs",
    "test:client-upgrade": "node scripts/check-client-upgrade.mjs",
    "test:upstream-runtime": "node scripts/test-upstream-runtime.mjs",
    "test:conversation-runtime": "node scripts/test-conversation-runtime.mjs",
    "test:workspace-runtime": "node scripts/test-workspace-runtime.mjs",
    "test:routines-runtime": "node scripts/test-routines-runtime.mjs",
    "test:apps-runtime": "node scripts/test-apps-runtime.mjs",
    "test:memory-summary-runtime": "node scripts/test-memory-summary-runtime.mjs",
    "test:memory-backup-runtime": "node scripts/test-memory-backup-runtime.mjs",
    "test:browser-components": "node tests/browser/skills-lifecycle.mjs && node tests/browser/memory-query-lifecycle.mjs && node tests/browser/workspace-controls-lifecycle.mjs && node tests/browser/decision-dock-lifecycle.mjs && node tests/browser/workbench-tabs-lifecycle.mjs",
    "storybook": "pnpm --filter @workspace/ui storybook",
    "build:storybook": "pnpm --filter @workspace/ui build-storybook",
    "test:ui": "pnpm --filter @workspace/ui test",
    "test:ui:browser": "pnpm --filter @workspace/ui test:browser",
    "deploy:ui": "pnpm --filter @workspace/ui deploy",
    "lint:effect": "effect-tsrs diagnostics --project tsconfig.json --lspconfig '{}'",
    "bench:typecheck": "node scripts/bench-typecheck.mjs",
    "test:tooling": "node --test scripts/typecheck-tooling.test.mjs",
    "typecheck:rust": "tsrs --noEmit",
    "typecheck:typescript": "tsc --noEmit"
  },
  "dependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.83",
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "1.7.10",
    "@chat-adapter/whatsapp": "4.42.0",
    "@cloudflare/puppeteer": "1.4.0",
    "@cloudflare/sandbox": "1.0.1",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@effect/platform-bun": "4.0.5",
