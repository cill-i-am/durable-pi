# Copy to .env. Never commit real values. Alchemy binds redacted values as Worker secrets.
BETTER_AUTH_SECRET=
SETUP_TOKEN=
OWNER_EMAIL=owner@example.com
# Filled by pnpm model:login. This is a serialized Pi OAuth credential or API-key credential.
OPENAI_CREDENTIAL=
MODEL_ID=gpt-6.1-sol
SUMMARY_MODEL_ID=gpt-6-luna
